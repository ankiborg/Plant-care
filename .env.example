# --- Database (Railway) ---
# Railway → your Postgres service → "Variables" tab → copy DATABASE_URL
# (use the PUBLIC url for running locally; the internal one only works inside Railway)
DATABASE_URL="postgresql://user:password@host:5432/railway"

# --- Cloudinary (photo uploads) ---
# Cloudinary dashboard → "API Keys" → copy the "API environment variable"
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# --- Claude vision (plant photo recognition) ---
# console.anthropic.com → API keys. Used for "Identify from photo" and the
# plant "Diagnose" health check.
ANTHROPIC_API_KEY="sk-ant-..."

# --- Stage 2: reminders ---
# Long random unguessable string — the ntfy topic IS the secret.
# Generate one in PowerShell:  -join ((48..57)+(97..122) | Get-Random -Count 40 | % {[char]$_})
NTFY_TOPIC="change-me-long-random-topic-string"
# The app's public base URL on Railway (no trailing slash) — used for notification deep links
APP_URL="https://your-app.up.railway.app"
# Shared secret between the GitHub Action and /api/cron/reminders
CRON_SECRET="change-me-another-long-random-string"
